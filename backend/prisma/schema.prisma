// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        String   @id @default(uuid())
  userId    String
  content   String
  createdAt DateTime @default(now())

  room   Room   @relation(fields: [roomId], references: [id]) //roomId is foregn key, id is RoomID
  roomId String
}

model Room {
  id        String   @id
  createdAt DateTime @default(now())

  messages Message[] //1 to N relation
}
